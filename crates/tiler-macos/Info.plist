<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleIdentifier</key>
    <string>io.github.omnitiler.macos.probe</string>
    <key>CFBundleName</key>
    <string>OmniTilerProbe</string>
    <key>CFBundleVersion</key>
    <string>0.1.0</string>
    <key>CFBundleShortVersionString</key>
    <string>0.1.0</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleExecutable</key>
    <string>tiler-macos</string>
    <key>LSMinimumSystemVersion</key>
    <string>15.0</string>
    <key>LSArchitecturePriority</key>
    <array>
        <string>arm64</string>
    </array>
    <key>NSHighResolutionCapable</key>
    <true/>
    <!-- Agent (no Dock icon, never takes front-process status): the probe
         measures foreground (SLPS front == NSWorkspace frontmost) and must
         not perturb it at launch. A regular APPL bundle activated by
         `open -n` holds the SLPS front process while NSWorkspace still
         attributes the previous app, splitting the very foreground under
         test; LSUIElement keeps both legs on the true frontmost. -->
    <key>LSUIElement</key>
    <true/>
    <!-- No TCC usage strings yet: Phase 0 probe requests nothing by default.
         Accessibility / Input Monitoring entries are added only with the
         authorized live experiment that needs them. -->
</dict>
</plist>
