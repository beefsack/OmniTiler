    message(FATAL_ERROR "drag-oracle FFI validation failed: 'DragOracleRect' missing from FFI header")
endif()
string(FIND "${DRAG_RUST_TEXT}" "DragRect" DRAG_POD_RUST_POS)
if(DRAG_POD_RUST_POS EQUAL -1)
    message(FATAL_ERROR "drag-oracle FFI validation failed: 'DragRect' missing from Rust source")
endif()
foreach(DRAG_REQUIRED "catch_unwind" "correlation" "cancelled" "finalRect" "windowIdentity" "no-change" "geometry-invalid")
    string(FIND "${DRAG_RUST_TEXT}" "${DRAG_REQUIRED}" DRAG_REQUIRED_POS)
    if(DRAG_REQUIRED_POS EQUAL -1)
        message(FATAL_ERROR "drag-oracle Rust validation failed: '${DRAG_REQUIRED}' not found in oracle source")
    endif()
endforeach()
foreach(DRAG_VAGUE "\"reason\":\"failure\"" "\"reason\":\"error\"" "\"reason\":\"unknown\"")
    string(FIND "${DRAG_RUST_TEXT}" "${DRAG_VAGUE}" DRAG_VAGUE_POS)
    if(NOT DRAG_VAGUE_POS EQUAL -1)
        message(FATAL_ERROR "drag-oracle Rust validation failed: oracle must not carry vague failure token ${DRAG_VAGUE}")
    endif()
endforeach()

message(STATUS "metadata/factory validation passed for ${METADATA_FILE} and ${KCM_METADATA_FILE}")
