      <item>
       <widget class="QLabel" name="scriptStatusDescription">
        <property name="text">
         <string>Gap settings are saved to kwinrc. Saving changed gaps sends one typed KWin reconfigure request; the send is unconfirmed and never claims the running tiler applied the settings. Session restart is the guaranteed pickup mechanism for gaps and the startup setting. Workspace mode requires a session restart: it is consumed at startup.</string>
        </property>
        <property name="wordWrap">
         <bool>true</bool>
        </property>
       </widget>
      </item>
