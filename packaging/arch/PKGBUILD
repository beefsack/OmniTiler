# Tentative 0.1 offline-preparation recipe, AUR-only scope (no OBS pacman
# repo). Not yet published to the AUR; see docs/installation.md for status,
# blockers, and the KWin-upgrade policy. Arch package names verified against
# Arch:Extra (x86_64) in October 2026.
#
# Source contract: the source tarball is the immutable GitHub Release asset
# produced by release.yml (scripts/build-source-archive.sh). It already
# contains the prebuilt KWin bundle and vendored Rust crates, so the build
# never runs npm and never touches the network. A VCS checkout would lack
# both and must not be substituted here.
# Maintainer: OmniTiler Contributors (tentative; replace with the
# publishing maintainer at release time)
pkgbase=omnitiler
pkgname=(omnitiler omnitiler-native-effect)
pkgver=0.1.0
pkgrel=1
pkgdesc='COSMIC-style automatic tiling for KWin (core: script, planner, tray)'
arch=(x86_64)
url='https://github.com/beefsack/OmniTiler'
license=('MIT' 'GPL-2.0-or-later')
# No release exists yet, so no digest can be pinned. At release time
# packaging/bump-version.sh fills this from the published .sha256 sidecar;
# until then the checksum stays SKIP and the prepare() VERSION assertion
# below is the fail-closed identity check.
source=("https://github.com/beefsack/OmniTiler/releases/download/v$pkgver/omnitiler-$pkgver.tar.gz")
sha256sums=(SKIP)
# KWin headers ship in the main kwin package on Arch (no -dev split).
# The rust package provides both rustc and cargo.
# KWin's CMake config needs Vulkan headers (runtime alone is insufficient).
makedepends=(cmake gcc rust extra-cmake-modules kwin qt6-base
             kconfig kcoreaddons kcmutils ki18n kwidgetsaddons kcolorscheme
             hicolor-icon-theme vulkan-headers)

prepare() {
  cd "$pkgbase-$pkgver"
  # Fail closed: the recipe version must match the immutable release tarball.
  [[ "$(cat VERSION)" == "$pkgver" ]] || exit 1
  grep -Eq '^[0-9a-f]{40}([0-9a-f]{24})?$' SOURCE_REV || exit 1
  grep -Fq "$(cat SOURCE_REV)" kwin/contents/code/main.js || exit 1
  test -d vendor || exit 1
  test -f THIRD-PARTY-NOTICES || exit 1
}

build() {
  cd "$pkgbase-$pkgver"
  # Offline Rust core build, exactly per scripts/build-source-archive.sh.
  # (The --config directory value carries inner double quotes: cargo's CLI
  # expression parser requires quoted strings.)
  export CARGO_NET_OFFLINE=true
  local vendor_dir="$PWD/vendor"
  cargo --config 'source.crates-io.replace-with="vendored-sources"' \
        --config "source.vendored-sources.directory=\"$vendor_dir\"" \
        build --release --locked --offline -p omnitiler
  # Native effect against Arch's own KWin headers. Same vendor tree via
  # OMNITILER_VENDOR_DIR (see kwin/native-effect/CMakeLists.txt).
  export OMNITILER_VENDOR_DIR="$PWD/vendor"
  cmake -S kwin/native-effect -B build-native \
    -DCMAKE_BUILD_TYPE=Release \
    -DBUILD_TESTING=OFF \
    -DCMAKE_INSTALL_PREFIX=/usr
  cmake --build build-native
}

package_omnitiler() {
  pkgdesc='COSMIC-style automatic tiling for KWin with Settings pages; press Revert in Settings before removing'
  license=('MIT')
  # Core ships the KCMs, so their direct Qt/KF6 runtimes plus the
  # enable/Settings journey helpers (kwriteconfig6/kreadconfig6 in kconfig,
  # kcmshell6 in kcmutils) are hard requirements, not optionals. kwin stays
  # as the script host; hicolor-icon-theme for the icon layout.
  depends=(kwin hicolor-icon-theme qt6-base kconfig kcoreaddons kcmutils ki18n kwidgetsaddons)
  install=omnitiler.install
  optdepends=('omnitiler-native-effect: ABI-matched active-border effect (Settings live in core)')
  cd "$pkgbase-$pkgver"
  install -Dm755 target/release/omnitiler "$pkgdir/usr/bin/omnitiler"
  # KWin script: the exact prebuilt four-file set, no npm involved.
  local scriptdir="$pkgdir/usr/share/kwin/scripts/omnitiler-kwin"
  install -Dm644 kwin/metadata.json "$scriptdir/metadata.json"
  install -Dm644 kwin/contents/code/main.js "$scriptdir/contents/code/main.js"
  install -Dm644 kwin/contents/config/main.xml "$scriptdir/contents/config/main.xml"
  install -Dm644 kwin/contents/ui/config.ui "$scriptdir/contents/ui/config.ui"
  # D-Bus activation descriptor (template carries @out@, Nix-style).
  install -d "$pkgdir/usr/share/dbus-1/services"
  sed 's|@out@|/usr|' nix/com.omnitiler.Planner.service \
    > "$pkgdir/usr/share/dbus-1/services/com.omnitiler.Planner.service"
  # Systemd user units (mirrors home-manager-module.nix; never auto-enabled).
  install -Dm644 packaging/systemd/omnitiler-tray.service \
    "$pkgdir/usr/lib/systemd/user/omnitiler-tray.service"
  install -Dm644 packaging/systemd/omnitiler-planner.service \
    "$pkgdir/usr/lib/systemd/user/omnitiler-planner.service"
  install -Dm644 assets/icons/omnitiler.svg \
    "$pkgdir/usr/share/icons/hicolor/scalable/apps/omnitiler.svg"
  # MIT notice for the core payload (script, KCMs, tray/planner).
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/omnitiler/LICENSE"
  # Generated union third-party notice (both shipping Rust roots).
  install -Dm644 THIRD-PARTY-NOTICES \
    "$pkgdir/usr/share/licenses/omnitiler/THIRD-PARTY-NOTICES"
  # KWin-independent settings pages (Qt/KF6 only; JSON metadata is embedded
  # in the .so files at compile time, so no .json ships alongside).
  # Installed via the full native tree, minus the ABI-bound effect plugin
  # (which belongs to the companion below).
  DESTDIR="$pkgdir" cmake --install build-native
  rm -f "$pkgdir/usr/lib/qt6/plugins/kwin/effects/plugins/omnitiler-active-border.so"
}

package_omnitiler-native-effect() {
  pkgdesc='OmniTiler native KWin effect, active border only (optional, ABI-bound)'
  license=('GPL-2.0-or-later')
  # Deliberately unversioned KWin dependency: this package must never hold a
  # KWin upgrade back (a pinned dependency makes pacman -Su fail until the
  # effect is rebuilt/removed), and an exact dependency still would not prove
  # the loaded .so matches the running KWin. Rebuilds track KWin via the
  # kwin makedepends above; see docs/installation.md for the upgrade-window
  # limitation and the versioned factory IID check.
  depends=("omnitiler=$pkgver-$pkgrel" kwin)
  install=omnitiler-native-effect.install
  cd "$pkgbase-$pkgver"
  # Effect plugin only; Settings/Revert live in core, so removing this
  # package alone leaves them available. The exact-version core dependency
  # keeps effect/core installs paired. This split layout (both KCM plugins
  # in core, effect plugin here) is new and pre-release: no predecessor was
  # ever published, so no file-ownership migration across updates is claimed.
  DESTDIR="$pkgdir" cmake --install build-native
  rm -f "$pkgdir/usr/lib/qt6/plugins/kwin/effects/configs/omnitiler-active-border_config.so" \
    "$pkgdir/usr/lib/qt6/plugins/kwin/scripts/configs/omnitiler-kwin_config.so"
  # GPL effect text plus the MIT notice for the linked staticlib portion.
  install -Dm644 LICENSES/GPL-2.0-or-later.txt \
    "$pkgdir/usr/share/licenses/omnitiler-native-effect/GPL-2.0-or-later.txt"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/omnitiler-native-effect/MIT"
  # Generated union third-party notice (both shipping Rust roots, same
  # file as core).
  install -Dm644 THIRD-PARTY-NOTICES \
    "$pkgdir/usr/share/licenses/omnitiler-native-effect/THIRD-PARTY-NOTICES"
}

# vim: ft=sh
