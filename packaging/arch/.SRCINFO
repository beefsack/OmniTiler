pkgbase = omnitiler
	pkgdesc = COSMIC-style automatic tiling for KWin (core: script, planner, tray)
	pkgver = 0.1.0
	pkgrel = 1
	url = https://github.com/beefsack/OmniTiler
	arch = x86_64
	license = MIT
	license = GPL-2.0-or-later
	makedepends = cmake
	makedepends = gcc
	makedepends = rust
	makedepends = extra-cmake-modules
	makedepends = kwin
	makedepends = qt6-base
	makedepends = kconfig
	makedepends = kcoreaddons
	makedepends = kcmutils
	makedepends = ki18n
	makedepends = kwidgetsaddons
	makedepends = kcolorscheme
	makedepends = hicolor-icon-theme
	makedepends = vulkan-headers
	source = https://github.com/beefsack/OmniTiler/releases/download/v0.1.0/omnitiler-0.1.0.tar.gz
	sha256sums = SKIP

pkgname = omnitiler
	pkgdesc = COSMIC-style automatic tiling for KWin with Settings pages; press Revert in Settings before removing
	install = omnitiler.install
	license = MIT
	depends = kwin
	depends = hicolor-icon-theme
	depends = qt6-base
	depends = kconfig
	depends = kcoreaddons
	depends = kcmutils
	depends = ki18n
	depends = kwidgetsaddons
	optdepends = omnitiler-native-effect: ABI-matched active-border effect (Settings live in core)

pkgname = omnitiler-native-effect
	pkgdesc = OmniTiler native KWin effect, active border only (optional, ABI-bound)
	install = omnitiler-native-effect.install
	license = GPL-2.0-or-later
	depends = omnitiler=0.1.0-1
	depends = kwin
