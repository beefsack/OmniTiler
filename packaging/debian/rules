#!/usr/bin/make -f
# 0.1 two-package recipe for Ubuntu 26.04/26.10 (see docs/installation.md).
# Core (omnitiler) ships the KWin script, the Rust planner/tray binary, and
# both native settings pages, built settings-only
# (OMNITILER_BUILD_EFFECT=OFF): no kwin-dev, ECM floor 6.24 matching the
# tested extra-cmake-modules and KF6 stacks. The companion
# (omnitiler-native-effect) is the ABI-bound active-border effect only,
# built effect-only (OMNITILER_BUILD_SETTINGS=OFF) against this target's own
# KWin headers and exactly pinned to the libkwin6 distro build compiled
# against (see override_dh_gencontrol).
#
# Core-only profile: DEB_BUILD_PROFILES=noeffect skips the effect build and
# drops its Build-Depends (kwin-dev, colorscheme, libdrm, pkg-config), so
# core-only builders never need KWin headers.
#
# Source contract: build from the immutable GitHub Release tarball produced
# by release.yml (scripts/build-source-archive.sh), which already contains
# the prebuilt KWin bundle and vendored Rust crates. Never runs npm, never
# touches the network.

export CARGO_NET_OFFLINE = true

%:
	dh $@

# The tray unit ships [Install] so the user can opt in with
# `systemctl --user enable`, but the package itself must never auto-enable
# it on install (the tray is opt-in everywhere else too). --no-enable keeps
# the daemon-reload bookkeeping while dropping the enable step (verified:
# the generated postinst enables otherwise).
override_dh_installsystemduser:
	dh_installsystemduser --no-enable

# dh_clean treats *.orig as patch debris and would delete cargo vendor's
# original-manifest backups (vendor/*/*.orig), which the offline build
# needs for checksum calculation. Exclude the vendor tree (verified: a
# plain `debian/rules clean` visibly deletes them otherwise). Cargo's
# target/ is not standard dh_clean cruft, so remove it explicitly to keep
# the source package clean.
override_dh_clean:
	dh_clean -Xvendor
	rm -rf target build-settings build-effect

override_dh_auto_build:
	# Fail closed: the recipe version must match the release tarball.
	test "$$(cat VERSION)" = "$$(dpkg-parsechangelog -S Version | cut -d- -f1)"
	grep -Eq '^[0-9a-f]{40}([0-9a-f]{24})?$$' SOURCE_REV
	grep -Fq "$$(cat SOURCE_REV)" kwin/contents/code/main.js
	test -d vendor
	# Offline Rust core build, exactly per scripts/build-source-archive.sh.
	# (The --config directory value carries inner double quotes: cargo's
	# CLI expression parser requires quoted strings.)
	cargo --config 'source.crates-io.replace-with="vendored-sources"' \
	      --config "source.vendored-sources.directory=\"$$PWD/vendor\"" \
	      build --release --locked --offline -p omnitiler
	# Settings-only native KCMs (Qt/KF6 only): no KWin, no Cargo effect
	# staticlib, no network. Default CMake build would require kwin-dev.
	cmake -S kwin/native-effect -B build-settings \
	      -DCMAKE_BUILD_TYPE=Release \
	      -DBUILD_TESTING=OFF \
	      -DOMNITILER_BUILD_EFFECT=OFF \
	      -DOMNITILER_BUILD_SETTINGS=ON \
	      -DCMAKE_INSTALL_PREFIX=/usr
	cmake --build build-settings
	# ABI-bound effect, effect-only (no Settings rebuild): needs this
	# target's own KWin headers (find_package(KWin 6.6.0 REQUIRED) fails
	# closed below that) plus the same offline vendor tree via
	# OMNITILER_VENDOR_DIR. Skipped under the noeffect profile.
	if [ -z "$(filter noeffect,$(DEB_BUILD_PROFILES))" ]; then \
	  OMNITILER_VENDOR_DIR="$$PWD/vendor" cmake -S kwin/native-effect -B build-effect \
	    -DCMAKE_BUILD_TYPE=Release \
	    -DBUILD_TESTING=OFF \
	    -DOMNITILER_BUILD_EFFECT=ON \
	    -DOMNITILER_BUILD_SETTINGS=OFF \
	    -DCMAKE_INSTALL_PREFIX=/usr; \
	  cmake --build build-effect; \
	fi

override_dh_auto_install:
	install -Dm755 target/release/omnitiler debian/omnitiler/usr/bin/omnitiler
	scriptdir=debian/omnitiler/usr/share/kwin/scripts/omnitiler-kwin; \
	install -Dm644 kwin/metadata.json "$$scriptdir/metadata.json"; \
	install -Dm644 kwin/contents/code/main.js "$$scriptdir/contents/code/main.js"; \
	install -Dm644 kwin/contents/config/main.xml "$$scriptdir/contents/config/main.xml"; \
	install -Dm644 kwin/contents/ui/config.ui "$$scriptdir/contents/ui/config.ui"
	install -d debian/omnitiler/usr/share/dbus-1/services
	sed 's|@out@|/usr|' nix/com.omnitiler.Planner.service \
	  > debian/omnitiler/usr/share/dbus-1/services/com.omnitiler.Planner.service
	chmod 644 debian/omnitiler/usr/share/dbus-1/services/com.omnitiler.Planner.service
	install -Dm644 packaging/systemd/omnitiler-tray.service \
	  debian/omnitiler/usr/lib/systemd/user/omnitiler-tray.service
	install -Dm644 packaging/systemd/omnitiler-planner.service \
	  debian/omnitiler/usr/lib/systemd/user/omnitiler-planner.service
	install -Dm644 assets/icons/omnitiler.svg \
	  debian/omnitiler/usr/share/icons/hicolor/scalable/apps/omnitiler.svg
	# KWin-independent settings pages (JSON metadata is embedded in the
	# .so files at compile time, so no .json ships alongside). Runtime KF
	# dependencies resolve via shlibdeps into ${shlibs:Depends}.
	DESTDIR=$$(pwd)/debian/omnitiler cmake --install build-settings
	# Effect plugin only (effect-only build installs just the plugin, so no
	# Settings files need pruning). Skipped under the noeffect profile.
	if [ -z "$(filter noeffect,$(DEB_BUILD_PROFILES))" ]; then \
	  DESTDIR=$$(pwd)/debian/omnitiler-native-effect cmake --install build-effect; \
	fi

# The effect companion must depend on the exact libkwin6 distro build it was
# compiled against, including the Debian revision (not only the upstream
# version): kwin-dev depends on that exact libkwin6, so the installed
# libkwin6 version at build time is the compiled-against build. Record it as
# the kwin:Version substvar used in debian/control. Core stays lower-bounded
# (kwin-wayland|kwin-x11 >= 4:6.6) with no exact pin.
override_dh_gencontrol:
	if [ -z "$(filter noeffect,$(DEB_BUILD_PROFILES))" ]; then \
	  echo "kwin:Version=$$(dpkg-query -W -f='$${Version}' libkwin6)" >> debian/omnitiler-native-effect.substvars; \
	fi
	dh_gencontrol
