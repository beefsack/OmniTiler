{
  "format": "world-wire-v4-ordered-scenario",
  "id": "rejected-command-observation",
  "driver": "core",
  "initial": {
    "freshEngine": true,
    "generationSequence": [
      "generation-a",
      "generation-b"
    ],
    "adapter": "adapter-a",
    "native": {}
  },
  "steps": [
    {
      "id": "handshake",
      "input": {
        "kind": "wire",
        "to": "core",
        "message": {
          "type": "handshake",
          "v": 4,
          "adapter": "adapter-a",
          "req": "handshake-a",
          "capabilities": {
            "hostOwned": false,
            "equalCount": false,
            "birthClear": true,
            "windowSuppression": true,
            "maximize": true,
            "fullscreen": true,
            "sticky": true,
            "tiledFloatTransfer": true
          }
        }
      },
      "expect": {
        "status": "settled",
        "assertions": [
          ".output.message == {type:\"handshake-reply\",v:4,adapter:\"adapter-a\",req:\"handshake-a\",gen:\"generation-a\",ready:false,kind:\"\"}"
        ]
      },
      "rules": [
        "handshake-and-lifetime"
      ]
    },
    {
      "id": "settings",
      "input": {
        "kind": "wire",
        "to": "core",
        "message": {
          "type": "settings",
          "v": 4,
          "adapter": "adapter-a",
          "gen": "generation-a",
          "req": "settings-1",
          "rev": "1",
          "values": {
            "gap": 8,
            "outer": 8,
            "defaultTiled": true,
            "mode": "per-output-local",
            "sameAxis": "group-with-neighbor",
            "bornMaximized": "tile-on-launch",
            "predicate": "both-axes-fixed",
            "anchorFallback": "largest-splittable-window",
            "noSpaceResult": "float",
            "refill": "last-remaining-workspace",
            "switchTarget": "cursor-output",
            "freshPlacement": "cursor-output-last-focused",
            "focusFollowsCursor": false,
            "cursorWarp": false,
            "borderEnabled": true,
            "underlayEnabled": true,
            "borderWidth": 3,
            "borderGap": 0,
            "borderRadius": 6,
            "underlayExtension": -1
          }
        }
      },
      "expect": {
        "status": "settled",
        "assertions": [
          ".output.message.status == \"accepted\" and .output.message.diagnostics == []",
          ".output.actions == []"
        ]
      },
      "rules": [
        "revisioned-settings"
      ]
    },
