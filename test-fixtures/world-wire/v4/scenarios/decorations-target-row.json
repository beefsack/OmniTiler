      "id": "handshake",
      "input": {
        "kind": "wire",
        "to": "core",
        "message": {
          "type": "handshake",
          "v": 4,
          "adapter": "adapter-a",
          "req": "handshake-a",
          "applicationIdentity": {
            "appId": null,
            "executable": "c:\\synthetic\\omnitiler.exe",
            "processId": "pid-own-1"
          },
          "capabilities": {
            "hostOwned": false,
            "equalCount": false,
            "birthClear": true,
            "nativeSelectorScope": "per-output",
            "windowSuppression": true,
            "maximize": true,
            "fullscreen": true,
            "nativeSticky": true,
            "above": true,
            "warp": true,
            "tiledFloatTransfer": true,
            "unavailableFacts": []
          }
        }
      },
      "expect": {
        "status": "settled",
        "assertions": [
          ".output.message == {type:\"handshake-reply\",v:4,adapter:\"adapter-a\",req:\"handshake-a\",gen:\"generation-a\",ready:false,kind:\"\"}"
        ]
      },
      "rules": [
        "handshake-and-lifetime"
      ]
    },
