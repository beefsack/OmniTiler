          "gen": "generation-a",
          "req": "settings-1",
          "rev": "1",
          "values": {
            "gap": 8,
            "outer": 8,
            "defaultTiled": true,
            "mode": "per-output-local",
            "sameAxis": "group-with-neighbor",
            "bornMaximized": "tile-on-launch",
            "predicate": "both-axes-fixed",
            "anchorFallback": "largest-splittable-window",
            "noSpaceResult": "float",
            "refill": "last-remaining-workspace",
            "switchTarget": "cursor-output",
            "freshPlacement": "cursor-output-last-focused",
            "focusFollowsCursor": false,
            "cursorWarp": false,
            "borderEnabled": true,
            "underlayEnabled": true,
            "borderWidth": 3,
            "borderGap": 0,
            "borderRadius": 6,
            "underlayExtension": -1
          }
        }
      },
      "expect": {
        "status": "settled",
        "assertions": [
          ".output.message.status == \"accepted\" and .output.message.diagnostics == []",
          ".output.actions == []"
        ]
      },
